<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>笑傲江湖 · 林平之命运抉择</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+XiaoWei&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#efe6d2;
    --paper-2:#e6d9bd;
    --ink:#2b2620;
    --ink-soft:#4a4234;
    --seal:#9e2b25;
    --gold:#b8893b;
    --blue:#3f6f7a;
    --pink:#a8556a;
    --green:#5a7d4f;
    --line:#8a7a58;
    --shadow:rgba(43,38,32,.25);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:"ZCOOL XiaoWei","KaiTi","STKaiti","楷体",serif;
    color:var(--ink);
    background:
      radial-gradient(circle at 20% 15%, rgba(120,95,55,.10), transparent 45%),
      radial-gradient(circle at 80% 85%, rgba(120,95,55,.12), transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(160,130,80,.06), transparent 70%),
      linear-gradient(135deg,#d9c8a4 0%,#e8dcc0 40%,#ddd0b0 100%);
    background-attachment:fixed;
    min-height:100vh;
    line-height:1.9;
  }
  /* paper grain overlay */
  body::before{
    content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
    background-image:
      repeating-linear-gradient(0deg, rgba(120,95,55,.025) 0 2px, transparent 2px 4px),
      repeating-linear-gradient(90deg, rgba(120,95,55,.02) 0 3px, transparent 3px 6px);
    mix-blend-mode:multiply;opacity:.6;
  }
  .wrap{
    position:relative;z-index:1;
    max-width:880px;margin:0 auto;padding:28px 18px 60px;
  }
  /* scroll / frame */
  .scroll{
    position:relative;
    background:
      radial-gradient(circle at 15% 20%, rgba(255,250,235,.5), transparent 40%),
      linear-gradient(180deg,#f3ecd9,#e9ddc2);
    border:3px double var(--line);
    box-shadow:0 10px 40px var(--shadow), inset 0 0 60px rgba(150,120,70,.18);
    padding:34px 30px 40px;
    border-radius:4px;
  }
  .scroll::before,.scroll::after{
    content:"";position:absolute;left:-10px;right:-10px;height:14px;
    background:linear-gradient(180deg,#7a6336,#5d4a26);
    border-radius:8px;box-shadow:0 4px 10px var(--shadow);
  }
  .scroll::before{top:-17px;}
  .scroll::after{bottom:-17px;}

  /* corner brackets */
  .corner{position:absolute;width:26px;height:26px;border:2px solid var(--seal);opacity:.55;}
  .c-tl{top:8px;left:8px;border-right:none;border-bottom:none;}
  .c-tr{top:8px;right:8px;border-left:none;border-bottom:none;}
  .c-bl{bottom:8px;left:8px;border-right:none;border-top:none;}
  .c-br{bottom:8px;right:8px;border-left:none;border-top:none;}

  h1.title{
    font-family:"Ma Shan Zheng","STXingkai","华文行楷",cursive;
    text-align:center;font-size:42px;letter-spacing:6px;margin:.1em 0 .1em;
    color:var(--ink);text-shadow:1px 2px 0 rgba(158,43,37,.18);
  }
  .subtitle{text-align:center;color:var(--ink-soft);font-size:17px;letter-spacing:3px;margin-bottom:6px;}
  .chapter-tag{
    display:inline-block;font-family:"Ma Shan Zheng",cursive;
    color:var(--seal);border:1px solid var(--seal);border-radius:3px;
    padding:1px 12px;font-size:16px;letter-spacing:2px;margin-bottom:14px;
  }
  .rule{height:1px;background:linear-gradient(90deg,transparent,var(--line),transparent);margin:14px 0;}

  /* narrative */
  .scene{
    font-size:18.5px;color:var(--ink-soft);min-height:120px;
    animation:fade .7s ease;
  }
  .scene p{margin:.4em 0;text-indent:2em;}
  .scene .em{color:var(--seal);font-weight:bold;}
  .scene .ink-em{color:var(--blue);font-weight:bold;}
  @keyframes fade{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}

  /* stats */
  .stats{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px 18px;
    margin:18px 0 6px;padding:14px 16px;background:rgba(255,250,238,.45);
    border:1px solid var(--line);border-radius:4px;
  }
  .stat{font-size:15px;}
  .stat .lab{display:flex;justify-content:space-between;margin-bottom:3px;}
  .stat .lab b{font-weight:normal;}
  .stat .lab .val{font-family:"Ma Shan Zheng",cursive;font-size:15px;}
  .bar{height:9px;background:rgba(120,95,55,.18);border-radius:6px;overflow:hidden;border:1px solid rgba(120,95,55,.3);}
  .bar > i{display:block;height:100%;border-radius:6px;transition:width .6s ease;}
  .b-wuxia i{background:linear-gradient(90deg,#c79a4a,#b8893b);}
  .b-hatred i{background:linear-gradient(90deg,#c0392b,#9e2b25);}
  .b-sanity i{background:linear-gradient(90deg,#5b97a3,#3f6f7a);}
  .b-shan i{background:linear-gradient(90deg,#c06b80,#a8556a);}
  .b-chong i{background:linear-gradient(90deg,#7a9c6b,#5a7d4f);}

  /* choices */
  .choices{margin-top:20px;display:flex;flex-direction:column;gap:12px;}
  .choice{
    font-family:inherit;font-size:17px;color:var(--ink);text-align:left;
    background:linear-gradient(180deg,#f6efdd,#e7d9ba);
    border:1px solid var(--line);border-left:5px solid var(--seal);
    padding:12px 16px;border-radius:3px;cursor:pointer;
    transition:all .2s ease;box-shadow:0 2px 6px rgba(43,38,32,.12);
    position:relative;
  }
  .choice:hover{background:linear-gradient(180deg,#fff7e6,#efdfbe);transform:translateX(4px);box-shadow:0 4px 12px rgba(43,38,32,.2);}
  .choice .eff{display:block;font-size:13px;color:var(--ink-soft);margin-top:5px;opacity:.85;}
  .choice .num{font-family:"Ma Shan Zheng",cursive;color:var(--seal);margin-right:8px;}

  /* seal */
  .seal{
    position:absolute;top:18px;right:24px;width:54px;height:54px;
    border:2px solid var(--seal);border-radius:6px;color:var(--seal);
    font-family:"Ma Shan Zheng",cursive;font-size:30px;line-height:54px;text-align:center;
    transform:rotate(-6deg);opacity:.8;box-shadow:inset 0 0 0 2px rgba(158,43,37,.25);
  }

  /* buttons */
  .btn{
    font-family:"Ma Shan Zheng",cursive;letter-spacing:3px;font-size:20px;
    color:#f3ecd9;background:linear-gradient(180deg,#a8362f,#8a241f);
    border:1px solid #6e1c18;padding:10px 30px;border-radius:4px;cursor:pointer;
    box-shadow:0 4px 12px rgba(120,30,25,.35);transition:all .2s;
  }
  .btn:hover{background:linear-gradient(180deg,#bb423a,#9a2a24);transform:translateY(-2px);}
  .center{text-align:center;margin-top:24px;}

  /* title screen */
  .cover{text-align:center;padding:30px 10px;}
  .cover .big{font-family:"Ma Shan Zheng",cursive;font-size:64px;letter-spacing:10px;color:var(--ink);text-shadow:2px 3px 0 rgba(158,43,37,.2);}
  .cover .poem{font-size:18px;color:var(--ink-soft);margin:14px auto;max-width:560px;line-height:2.1;}
  .cover .tag{color:var(--seal);letter-spacing:4px;}

  /* ending */
  .ending{animation:fade .9s ease;}
  .ending h2{font-family:"Ma Shan Zheng",cursive;font-size:34px;color:var(--seal);text-align:center;letter-spacing:4px;}
  .ending .tier{text-align:center;font-size:16px;color:var(--ink-soft);margin-bottom:10px;letter-spacing:2px;}
  .ending .body{font-size:18px;color:var(--ink-soft);}
  .ending .body p{text-indent:2em;margin:.5em 0;}
  .ending .verdict{margin-top:14px;padding:12px 16px;border:1px dashed var(--seal);border-radius:4px;background:rgba(158,43,37,.06);font-size:15.5px;}

  .footnote{text-align:center;color:var(--ink-soft);font-size:13px;margin-top:18px;opacity:.7;}
  @media(max-width:560px){
    h1.title{font-size:32px;}
    .cover .big{font-size:46px;}
    .scene{font-size:17px;}
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="scroll">
    <span class="corner c-tl"></span><span class="corner c-tr"></span>
    <span class="corner c-bl"></span><span class="corner c-br"></span>
    <div class="seal">林</div>
    <div id="app"></div>
  </div>
  <div class="footnote">本游戏为基于金庸《笑傲江湖》之同人改编创作，仅供娱乐与命运思辨。</div>
</div>

<script>
/* ===================== 状态模型 ===================== */
function initState(){
  return {
    wuxia:5,        // 武功
    hatred:15,      // 仇恨
    sanity:85,      // 理智（越高越清醒）
    lingShan:0,     // 岳灵珊好感
    huChong:0,      // 令狐冲好感
    parentsAlive:false,
    selfCastrated:false,
    blinded:false,
    killedShan:false,
    revengeDone:false,
    escaped:false,
    betrayedZuo:false,
    burnedJianpu:false,
    knowsYueEvil:false,
    toldHuChong:false,
    hidden:false,
    chapter:""
  };
}
let state = initState();

const STAT_META = [
  {key:"wuxia",  name:"武功",  cls:"b-wuxia",  max:100},
  {key:"hatred", name:"仇恨",  cls:"b-hatred", max:100},
  {key:"sanity", name:"理智",  cls:"b-sanity", max:100},
  {key:"lingShan",name:"灵珊情",cls:"b-shan",  max:100},
  {key:"huChong",name:"冲哥义",cls:"b-chong", max:100},
];

/* ===================== 工具 ===================== */
function clamp(v,lo,hi){return Math.max(lo,Math.min(hi,v));}
function applyEffect(eff){
  if(!eff) return;
  for(const k in eff){
    if(k==="flag"){ for(const f in eff.flag) state[f]=eff.flag[f]; continue; }
    if(state.hasOwnProperty(k)) state[k]=clamp(state[k]+eff[k],0,100);
  }
}
function reqMet(req){
  if(!req) return true;
  if(req.stat){
    for(const k in req.stat){ if((state[k]||0) < req.stat[k]) return false; }
  }
  if(req.flag){ for(const f in req.flag){ if(!!state[f] !== req.flag[f]) return false; } }
  return true;
}
function effText(eff){
  if(!eff) return "";
  const map = {wuxia:"武功",hatred:"仇恨",sanity:"理智",lingShan:"灵珊情",huChong:"冲哥义"};
  let parts=[];
  for(const k in eff){
    if(k==="flag") continue;
    const d=eff[k];
    if(d>0) parts.push(map[k]+" +"+d);
    else if(d<0) parts.push(map[k]+" "+d);
  }
  for(const f in (eff.flag||{})){
    if(f==="burnedJianpu") parts.push("焚毁剑谱");
    if(f==="knowsYueEvil") parts.push("识破岳不群");
    if(f==="toldHuChong") parts.push("托付冲哥");
    if(f==="hidden") parts.push("隐忍不发");
    if(f==="blinded") parts.push("双目失明");
    if(f==="revengeDone") parts.push("大仇得报");
    if(f==="killedShan") parts.push("痛失灵珊");
    if(f==="escaped") parts.push("携眷远走");
    if(f==="betrayedZuo") parts.push("反噬其主");
    if(f==="selfCastrated") parts.push("挥刀自宫");
  }
  return parts.join("，");
}

/* ===================== 剧情节点 ===================== */
const story = {
  n_intro:{
    chapter:"楔子",
    scene:[`福建福州，福威镖局。`,
      `你是林平之，镖局少总镖头。家世殷实，相貌俊美，自幼娇养，武功平平却心性纯善。江湖传言，你家传一部<span class="em">《辟邪剑谱》</span>，引得多少双眼睛暗中觊觎。`,
      `你只当那是祖宗留下的虚名，直到那一日的酒馆风波，将你拖入万劫不复的江湖。`,
      `这一局棋，落子无悔。<span class="ink-em">你，想做个怎样的人？</span>`],
    choices:[
      {text:"鲜衣怒马，入局", eff:{}, next:"n_tavern"}
    ]
  },

  n_tavern:{
    chapter:"第一幕 · 祸起福威",
    scene:[`郊野小酒馆。一个面容丑陋的卖酒女子正被地痞调戏，哭喊挣扎。`,
      `你认出其中一人是青城派弟子——你尚不知，他叫余人彦，是青城掌门余沧海的独子。`,
      `酒意与血气上涌，你握紧了剑柄。`],
    choices:[
      {text:"拔剑挺身，救下那女子", eff:{hatred:10,sanity:-2}, note:"侠义之心，却也埋下祸根", next:"n_kill"},
      {text:"佯作未见，悄然绕道离去", eff:{sanity:5,huChong:3}, note:"明哲保身，少一分牵连", next:"n_massacre"}
    ]
  },

  n_kill:{
    chapter:"第一幕 · 祸起福威",
    scene:[`你出手了。争执之间，剑锋失控，余人彦倒在你的脚下，再无声息。`,
      `你懵了。那女子揭开人皮面具——竟是华山派岳不群之女<span class="em">岳灵珊</span>易容。她匆匆离去，留下你一人面对尸体。`,
      `你不知道，余沧海本就图谋剑谱，杀子之仇，只是他动手的借口。`],
    choices:[
      {text:"事已至此，听天由命", eff:{}, next:"n_massacre"}
    ]
  },

  n_massacre:{
    chapter:"第一幕 · 祸起福威",
    scene:[`青城派倾巢而出，血洗福威镖局。你眼睁睁看着镖师们接连倒下，惨叫回荡在院落里。`,
      `父母被余沧海掳走，你侥幸逃脱，却已无家可归。`,
      `火光映红半边天，你站在废墟前，握紧双拳。`],
    choices:[
      {text:"持剑迎敌，与镖局共存亡", eff:{wuxia:10}, note:"以死明志，少总镖头的最后一战", next:"END:earlyDeath"},
      {text:"拼死护住父母，掩护其突围", eff:{wuxia:15,hatred:15,flag:{parentsAlive:true}}, note:"护亲族，自身负伤", next:"n_beggar"},
      {text:"为留有用之身，独自遁逃", eff:{hatred:25,sanity:-8}, note:"苟活，仇恨在心中生根", next:"n_beggar"}
    ]
  },

  n_beggar:{
    chapter:"第二幕 · 流亡乞儿",
    scene:[`你易容成满身恶疮的乞丐，混迹市井。`,
      `饥肠辘辘时，你偷了农家的几颗龙眼，被农妇拿棍棒追打，你咬牙不敢还手。`,
      `这一顿打，打掉了你最后一点少爷脾气，也打醒了你对这弱肉强食江湖的认知。`],
    choices:[
      {text:"忍辱偷生，把屈辱咽进肚里", eff:{sanity:-5,hatred:10}, note:"心智被磨砺得冷硬", next:"n_mugaofeng"},
      {text:"暂不低头，暗自记恨这世道", eff:{sanity:5,wuxia:5}, note:"保留一丝傲骨", next:"n_mugaofeng"}
    ]
  },

  n_mugaofeng:{
    chapter:"第二幕 · 流亡乞儿",
    scene:[`流亡途中，你撞上了<span class="em">"塞北明驼"木高峰</span>。他同样觊觎剑谱，欲以武力逼你拜师。`,
      `千钧一发，"君子剑"<span class="em">岳不群</span>如天降神明，惊退木高峰，大义凛然地将你收入华山门下。`,
      `你感激涕零，视他为人间灯塔——却不知，这座灯塔，正引你驶向深渊。`],
    choices:[
      {text:"拜入华山，奉岳不群为恩师", eff:{huChong:5}, next:"n_parents"}
    ]
  },

  n_parents:{
    chapter:"第二幕 · 流亡乞儿",
    scene:[`噩耗传来：父母在衡山城外被木高峰折磨致死。`,
      `弥留之际，父亲托大师兄<span class="em">令狐冲</span>转告你遗言："福州向阳巷老宅，祖宗遗物，不可翻看。"`,
      `你彻底成了孤儿。华山，成了你唯一的依靠。`],
    choices:[
      {text:"悲恸欲绝，立誓血债血偿", eff:{hatred:20,sanity:-10,huChong:5}, note:"仇恨如野火", next:"n_huashan"},
      {text:"强忍悲痛，暗中将仇记在心", eff:{sanity:10,hatred:10,huChong:5}, note:"藏锋于鞘", next:"n_huashan"},
      {text:"叩谢大师兄传信之恩义", eff:{huChong:15,sanity:5}, note:"结下手足之情", next:"n_huashan"}
    ]
  },

  n_huashan:{
    chapter:"第三幕 · 华山岁月",
    scene:[`华山岁月静好。你练功刻苦，俊朗勤勉，打动了青梅竹马的小师妹<span class="em">岳灵珊</span>。`,
      `你们朝夕相处，情愫暗生，你尝到了久违的暖意——哪怕这暖意，也许本就是一场精心编织的网。`],
    choices:[
      {text:"苦练华山剑法，潜心向学", eff:{wuxia:20,sanity:5}, note:"根基渐稳", next:"n_oldhouse"},
      {text:"暗中查探辟邪剑谱的下落", eff:{hatred:10,wuxia:5,flag:{knowsYueEvil:false}}, note:"心有疑虑", next:"n_oldhouse"},
      {text:"与灵珊相伴，珍惜眼前温情", eff:{lingShan:20,sanity:5}, note:"情根深种", next:"n_oldhouse"}
    ]
  },

  n_oldhouse:{
    chapter:"第三幕 · 华山岁月",
    scene:[`华山派行至福州。深夜，你潜回向阳巷老宅，在佛堂屋顶夹层里，翻出了写有剑谱的<span class="em">袈裟</span>。`,
      `可你刚到手，一道寒光袭来——蒙面人夺谱、砍伤你，意欲灭口。你屏息装死，从指缝间，看清了那蒙面人的身形。`],
    choices:[
      {text:"装死窥破：那蒙面人竟是岳不群！", eff:{sanity:-15,hatred:20,flag:{knowsYueEvil:true}}, note:"信仰崩塌", next:"n_discover"},
      {text:"奋起夺谱，与蒙面人殊死相拼", eff:{wuxia:10,sanity:-5,hatred:15}, note:"身负重伤，仍被夺走", next:"n_discover"},
      {text:"不动声色，悄然隐去", eff:{sanity:5}, note:"不露声色", next:"n_discover"}
    ]
  },

  n_discover:{
    chapter:"第四幕 · 剑谱迷局",
    scene:[ ()=> state.knowsYueEvil
        ? `你终于明白：岳不群收你为徒、促成你与灵珊的婚事，从头到尾，都是为了图谋剑谱。所谓"君子剑"，是最阴险的伪君子。`
        : `剑谱被夺，你心下疑窦丛生。岳不群的笑容，似乎不再那么可信。`,
      `你站在师门与真相的裂缝之间，必须抉择。`],
    choices:[
      {text:"继续隐忍，假意屈从于岳不群", eff:{sanity:-5,hatred:10,flag:{hidden:true}}, note:"扮猪吃虎", next:"n_jianpu"},
      {text:"当众揭穿这伪君子的真面目", eff:{sanity:-10,hatred:15,huChong:5}, note:"风险极大，或遭灭口", next:"n_jianpu"},
      {text:"私下告知大师兄令狐冲", eff:{huChong:20,sanity:5,flag:{toldHuChong:true}}, note:"结为同盟", next:"n_jianpu"}
    ]
  },

  n_jianpu:{
    chapter:"第四幕 · 剑谱迷局",
    scene:[`岳不群为掩人耳目，将写有剑谱的袈裟抛出窗外。你暗中寻回，抖开一看，开篇八个大字如惊雷炸响：`,
      `<span class="em">"欲练此功，必先自宫。"</span>`,
      `自宫，方可练成辟邪剑法；不练，则随时可能被岳不群、余沧海灭口。你攥紧袈裟，手心沁血。`],
