function evaluateEnding(){
  const s=state;
  if(s.escaped){
    if(!s.selfCastrated && s.sanity>=55 && s.lingShan>=20 && s.huChong>=10) return "perfect";
    return "wander";
  }
  if(s.selfCastrated && s.revengeDone && !s.killedShan) return "bloodRevenge";
  if(!s.selfCastrated && s.sanity>=55 && s.hatred<=45 && s.lingShan>=20 && s.huChong>=10) return "perfect";
  if(!s.selfCastrated) return "wander";
  return "meizhuang";
}

/* ===================== 渲染 ===================== */
const app=document.getElementById("app");

function statBars(){
  let h='<div class="stats">';
  for(const m of STAT_META){
    const v=clamp(state[m.key],0,m.max);
    h+=`<div class="stat"><div class="lab"><b>${m.name}</b><span class="val">${v}</span></div>`+
       `<div class="bar ${m.cls}"><i style="width:${v}%"></i></div></div>`;
  }
  h+='</div>';
  return h;
}

function renderCover(){
  app.innerHTML=`
    <div class="cover">
      <div class="tag">金庸《笑傲江湖》同人 · 交互文字RPG</div>
      <div class="big">林平之</div>
      <div class="poem">
        匹夫无罪，怀璧其罪。<br>
        他曾是鲜衣怒马的少年，<br>
        却被险恶的江湖、贪婪的人性，<br>
        一步步逼成了自己的噩梦。<br>
        今夜，命运的交椅交到你手中——<br>
        <span class="tag">你能替他，改写结局吗？</span>
      </div>
      <div class="center"><button class="btn" onclick="startGame()">入 局</button></div>
    </div>`;
}

function renderNode(id){
  if(id.startsWith("END:")){
    showEnding(id.slice(4));
    return;
  }
  const node=story[id];
  if(node.evaluate){ showEnding(evaluateEnding()); return; }
  state.chapter=node.chapter;
  let sceneHtml='';
  let sc=node.scene;
  if(typeof sc==="function") sc=sc();
  const arr=(Array.isArray(sc)?sc:[sc]).map(x=>typeof x==="function"?x():x);
  arr.forEach(p=>{ sceneHtml+=`<p>${p}</p>`; });

  let choicesHtml='<div class="choices">';
  let idx=1;
  node.choices.forEach(c=>{
    if(!reqMet(c.req)) return;
    const eff=effText(c.eff);
    choicesHtml+=`<button class="choice" onclick="go('${c.next}')">`+
      `<span class="num">${idx}.</span>${c.text}`+
      (eff?`<span class="eff">〔${eff}〕</span>`:``)+
      `</button>`;
    idx++;
  });
  choicesHtml+='</div>';

  app.innerHTML=`
    <div class="chapter-tag">${node.chapter}</div>
    <div class="scene">${sceneHtml}</div>
    <div class="rule"></div>
    ${statBars()}
    ${choicesHtml}`;
  window.scrollTo({top:0,behavior:"smooth"});
}

function go(next){
  // apply effect baked into the choice by looking it up? We apply at click time:
  // find current node & choice to apply effect
  // simpler: store pending effect on the button via data, but we passed next only.
  // We'll re-derive: search current rendered node for matching next and apply.
  const cur=window.__cur;
  if(cur && story[cur]){
    const ch=story[cur].choices.find(c=>c.next===next && reqMet(c.req));
    if(ch) applyEffect(ch.eff);
  }
  window.__cur=next.startsWith("END:")? null : next;
  renderNode(next);
}

function showEnding(id){
  const e=endings[id]||endings.meizhuang;
  let bodyHtml='';
  e.body.forEach(p=>bodyHtml+=`<p>${p}</p>`);
  app.innerHTML=`
    <div class="ending">
      <h2>${e.title}</h2>
      <div class="tier">${e.tier}</div>
      <div class="rule"></div>
      <div class="body">${bodyHtml}</div>
      <div class="verdict">${e.verdict}</div>
      <div class="stats" style="margin-top:18px;">${statBars().replace('<div class="stats">','<div class="stats" style="opacity:.9">')}</div>
      <div class="center"><button class="btn" onclick="restart()">重 新 开 始</button></div>
    </div>`;
  window.scrollTo({top:0,behavior:"smooth"});
}

function startGame(){
  state=initState();
  window.__cur="n_intro";
  renderNode("n_intro");
}
function restart(){
  startGame();
}

renderCover();
